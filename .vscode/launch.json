{
  "version": "0.2.0",
  "configurations": [

    
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Webpack Build",
      "program": "${workspaceFolder}/node_modules/.bin/webpack-cli", // Adjust path if needed
      "args": [
        "--mode=development",
        "--progress",
        "--watch",
        "--config",
        "config/webpack.config.js" // Specify your Webpack config file
      ],
      "autoAttachChildProcesses": true,
      "stopOnEntry": true // Pause at the beginning of the program
    }
  ]
}